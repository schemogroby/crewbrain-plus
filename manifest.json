{
  "manifest_version": 3,
  "name": "Zeiterfassung Plus für CrewBrain",
  "version": "1.0.1",
  "description": "Inoffizielle Helfer für die CrewBrain-Zeiterfassung: Anwesenheit im Raster, Zoom, Zeiten bündig setzen, bessere Aufgabensuche.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Zeiterfassung Plus für CrewBrain",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.crewbrain.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "short_name": "Zeiterfassung Plus"
}