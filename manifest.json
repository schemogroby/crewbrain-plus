{
  "manifest_version": 3,
  "name": "CrewBrain Plus",
  "version": "0.1.0",
  "description": "Schnellere Zeiterfassung in CrewBrain: Anwesenheit im Raster, bündig setzen, bessere Aufgabensuche.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CrewBrain Plus",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.crewbrain.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
